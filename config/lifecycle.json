{
	"Rules":[

		{
		
			"ID": "logs-lifecycle-test",
			"Status": "Enabled",
			"Filter": {
				"Prefix": "logs/"

			},
			"Transitions": [
				{
					"Days": 30,
					"StorageClass": "STANDARD_IA"
				}
			],
			"Expiration": {
				"Days": 365
			},
			"NoncurrentVersionExpiration": {
				"NoncurrentDays": 30
			}

		}

	]
}
